# Neon Database Configuration (PostgreSQL Serverless)
# Dapatkan dari: Neon Console > Project Dashboard > Connection String (Node.js)
DATABASE_URL="postgresql://username:password@ep-xxxx-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# App Environment
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_NAME="Pindaiin"

# Google OAuth 2.0 (Login with Google tanpa pihak ketiga)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Cloudflare Turnstile (Proteksi Anti-Bot Login & Daftar)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ==============================================================================
# Google / Gmail SMTP Configuration (Pengiriman Email OTP & Reset Password)
# ==============================================================================
# Panduan pembuatan Google App Password:
# 1. Buka myaccount.google.com -> Keamanan
# 2. Aktifkan "Verifikasi 2 Langkah"
# 3. Cari menu "Sandi Aplikasi" (App Passwords)
# 4. Beri nama "DigiUMKM" lalu buat
# 5. Salin 16 digit kode sandi ke SMTP_PASS tanpa spasi
# ==============================================================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE="true"
SMTP_USER="alamat-email-anda@gmail.com"
SMTP_PASS="xxxx-xxxx-xxxx-xxxx"
SMTP_FROM="DigiUMKM <noreply@digiumkm.id>"
